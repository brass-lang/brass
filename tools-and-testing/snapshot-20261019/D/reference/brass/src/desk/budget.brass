# desk/budget.brass
module desk.budget
import desk.ids as ids
import desk.lines as lines
import desk.reports as reports
import desk.advances as advances
import desk.trips as trips
import desk.host as host

interface
  fn spend_of(rs: reports.Reports, advs: advances.Advances, ts: trips.Trips) -> Int
    after result >= 0
  fn department_spend(store: host.Store, department: ids.DepartmentId, period: ids.Period) -> Outcome<Int>
  fn spend_after(store: host.Store, r: reports.Submitted) -> Outcome<Int>
body
  fn spend_of(rs, advs, ts) =
    let sum: Int = 0
    for r in rs
      if r is reports.Counted then sum = sum + lines.budgeted_total(r.lines)
    for a in advs
      if a is advances.Counted then sum = sum + a.amount
    for t in ts
      sum = sum + trips.counted(t, rs, 0)
    sum

  fn department_spend(store, department, period) =
    let rs: reports.Reports = store.reports_for(department, period)?
    let advs: advances.Advances = store.advances_for(department, period)?
    let ts: trips.Trips = store.trips_for(department, period)?
    Ok(spend_of(rs, advs, ts))

  fn spend_after(store, r) =
    let rs: reports.Reports = store.reports_for(r.department, r.period)?
    let advs: advances.Advances = store.advances_for(r.department, r.period)?
    let ts: trips.Trips = store.trips_for(r.department, r.period)?
    let own: Int = lines.budgeted_total(r.lines)
    let sum: Int = own
    for x in rs
      if x is reports.Counted then sum = sum + lines.budgeted_total(x.lines)
    for a in advs
      if a is advances.Counted then sum = sum + a.amount
    for t in ts
      let extra: Int = if t.badge == r.badge then own else 0
      sum = sum + trips.counted(t, rs, extra)
    Ok(sum)
