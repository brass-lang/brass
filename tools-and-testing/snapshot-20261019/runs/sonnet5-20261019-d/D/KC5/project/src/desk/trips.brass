# desk/trips.brass
module desk.trips
import desk.ids as ids
import desk.staff as staff
import desk.routing as routing
import desk.records as records
import desk.reports as reports
import desk.lines as lines
import desk.audit as audit
import desk.host as host
import desk.registry as registry
import desk.delegation as delegation
import desk.budget as budget
import std.text as text

interface
  fn file_trip(store: host.Store, badge: ids.Badge, period: ids.Period, region: records.Region, days: Int, vehicle: records.Vehicle, km: Int) -> Outcome<ids.ReportId>
    before days in 0 to 30 and km in 0 to 2000 and (days >= 1 or km >= 1)
  fn amend_trip(store: host.Store, trip_id: ids.ReportId, badge: ids.Badge, region: records.Region, days: Int, vehicle: records.Vehicle, km: Int) -> Outcome<records.TripStatus>
    before days in 0 to 30 and km in 0 to 2000 and (days >= 1 or km >= 1)
  fn approve_trip(store: host.Store, reg: registry.Registry, trip_id: ids.ReportId, approver: ids.Badge, today: ids.Period) -> Outcome<records.TripStatus>
  fn reconcile_trip(store: host.Store, reg: registry.Registry, trip_id: ids.ReportId, report_id: ids.ReportId, finance_badge: ids.Badge) -> Outcome<Int>
  fn close_trip(store: host.Store, trip_id: ids.ReportId, finance_badge: ids.Badge, reason: ids.Reason) -> Outcome<Done>
private
  type Gate = { t: records.TripRequested, who: staff.Active, via: Maybe<ids.Badge> }
  fn gate(store: host.Store, reg: registry.Registry, trip_id: ids.ReportId, approver: ids.Badge, today: ids.Period) -> Outcome<Gate>
  fn required_for(store: host.Store, submitter: ids.Badge, department: ids.DepartmentId, step: Int) -> Outcome<Maybe<ids.Badge>>
  fn stand_in(store: host.Store, required: ids.Badge) -> Outcome<Maybe<ids.Badge>>
  fn final_approval(store: host.Store, reg: registry.Registry, g: Gate, today: ids.Period) -> Outcome<records.TripStatus>
  fn compute_reconciliation(store: host.Store, reg: registry.Registry, t: records.Trip, report_id: ids.ReportId) -> Outcome<records.TripReconciliation>
body
  fn file_trip(store, badge, period, region, days, vehicle, km) =
    let who: staff.Staff = store.staff(badge)?
    if who is staff.Active then
      let closed: Bool = store.period_closed(period)?
      if not closed then
        let existing: records.Trips = store.trips_for(who.department, period)?
        if any t in existing where t.badge == badge and t.status in {records.TripStatus.Requested, records.TripStatus.Approved, records.TripStatus.Reconciled} then
          Err(FailureCode.Conflict, "the staff member already has an open trip for this period")
        else
          let committed: Int = records.trip_price(region, days, vehicle, km)
          let id: ids.ReportId = store.next_id()?
          store.save_trip({ id: id, badge: badge, department: who.department, period: period, region: region, days: days, vehicle: vehicle, km: km, committed: committed, approvals: [], status: records.TripStatus.Requested })?
          Ok(id)
      else Err(FailureCode.Conflict, "the period is closed")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn amend_trip(store, trip_id, badge, region, days, vehicle, km) =
    let who: staff.Staff = store.staff(badge)?
    if who is staff.Active then
      let t: records.Trip = store.trip(trip_id)?
      if t.badge == badge then
        if t is records.TripRequested then
          let committed: Int = records.trip_price(region, days, vehicle, km)
          store.save_trip(records.amend_trip_requested(t, region, days, vehicle, km, committed))?
          Ok(records.TripStatus.Requested)
        else if t is records.TripApproved then
          let committed: Int = records.trip_price(region, days, vehicle, km)
          store.save_trip(records.amend_trip_approved(t, region, days, vehicle, km, committed))?
          store.append_audit(audit.trip_entry(badge, t.id, records.TripStatus.Approved, records.TripStatus.Requested, "amended"))?
          Ok(records.TripStatus.Requested)
        else Err(FailureCode.Conflict, "the trip is reconciled or closed")
      else Err(FailureCode.Unauthorized, "only the staff member who filed a trip may amend it")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn gate(store, reg, trip_id, approver, today) =
    let who: staff.Staff = store.staff(approver)?
    if who is staff.Active then
      let t: records.Trip = store.trip(trip_id)?
      if t is records.TripRequested then
        let closed: Bool = store.period_closed(t.period)?
        if not closed then
          if who.badge != t.badge then
            let required: Maybe<ids.Badge> = required_for(store, t.badge, t.department, t.approvals.length + 1)?
            if required == None then
              if who.role in {ids.Role.Finance} then Ok({ t: t, who: who, via: None })
              else Err(FailureCode.Unauthorized, "not this trip's next approver")
            else if who.badge == required then Ok({ t: t, who: who, via: None })
            else
              let deputy: Maybe<ids.Badge> = delegation.delegate_in_force(reg, required, today)?
              if deputy != None and who.badge == deputy then Ok({ t: t, who: who, via: required })
              else Err(FailureCode.Unauthorized, "not this trip's next approver")
          else Err(FailureCode.Unauthorized, "a trip cannot be approved by its requester")
        else Err(FailureCode.Conflict, "the period is closed")
      else Err(FailureCode.Conflict, "the trip is not awaiting approval")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn required_for(store, submitter, department, step) =
    let role: ids.Role = routing.role_for(step)
    if role in {ids.Role.Finance} then Ok(None)
    else if role in {ids.Role.Supervisor} then
      let person: staff.Staff = store.staff(submitter)?
      if person.supervisor != None then stand_in(store, person.supervisor)
      else Err(FailureCode.Conflict, "the submitter has no supervisor")
    else
      let dept: staff.Department = store.department(department)?
      stand_in(store, dept.director)

  fn stand_in(store, required) =
    let person: staff.Staff = store.staff(required)?
    if person.active then Ok(required)
    else if person.supervisor != None then
      let up: staff.Staff = store.staff(person.supervisor)?
      if up.active then Ok(person.supervisor)
      else Err(FailureCode.Conflict, "no active approver stands in for " ++ required)
    else Err(FailureCode.Conflict, "no active approver stands in for " ++ required)

  fn approve_trip(store, reg, trip_id, approver, today) =
    let g: Gate = gate(store, reg, trip_id, approver, today)?
    if g.t.approvals.length + 1 >= routing.steps_for(g.t.committed) then final_approval(store, reg, g, today)
    else
      store.save_trip(records.add_trip_approval(g.t, g.who.badge))?
      let reason: ids.Reason = if g.via == None then "approved; awaiting the next approver" else "approved; awaiting the next approver; delegated for " ++ g.via ++ " in period " ++ text.of(today)
      store.append_audit(audit.trip_entry(g.who.badge, g.t.id, records.TripStatus.Requested, records.TripStatus.Requested, reason))?
      Ok(records.TripStatus.Requested)

  fn final_approval(store, reg, g, today) =
    let dept: staff.Department = store.department(g.t.department)?
    let spent: Int = budget.department_spend_with_trip(store, g.t.department, g.t.period, g.t.committed, g.t.badge)?
    let within: Bool = spent <= dept.budget
    if within or g.who.role in {ids.Role.Finance} then
      let reason: ids.Reason = if g.via == None then (if within then "approved" else "approved; budget override") else "approved; delegated for " ++ g.via ++ " in period " ++ text.of(today)
      store.save_trip(records.approve_trip(g.t))?
      store.append_audit(audit.trip_entry(g.who.badge, g.t.id, records.TripStatus.Requested, records.TripStatus.Approved, reason))?
      Ok(records.TripStatus.Approved)
    else Err(FailureCode.Conflict, "the department budget for this period would be exceeded")

  fn compute_reconciliation(store, reg, t, report_id) =
    let r: reports.Report = store.report(report_id)?
    if r.badge == t.badge and r.period == t.period then
      if r is reports.Counted then
        let txns: records.Txns = reg.txns_for(t.period)?
        let counted: Array<records.TxnId> where it.length in 0 to 1000 = []
        let extra: Int = 0
        for tx in txns
          if tx.badge == t.badge and tx.status in {records.CardStatus.Open, records.CardStatus.Disputed} then
            extra = extra + tx.amount
            counted = counted ++ [tx.id]
        let actual: Int = lines.total(r.lines) + extra
        Ok({ committed: t.committed, actual: actual, report: report_id, counted: counted })
      else Err(FailureCode.Conflict, "the report is not approved or paid")
    else Err(FailureCode.Conflict, "the report is not this staff member's report for this period")

  fn reconcile_trip(store, reg, trip_id, report_id, finance_badge) =
    let who: staff.Staff = store.staff(finance_badge)?
    if who is staff.Finance then
      let t: records.Trip = store.trip(trip_id)?
      if t is records.TripApproved then
        let recon: records.TripReconciliation = compute_reconciliation(store, reg, t, report_id)?
        store.save_trip(records.reconcile_trip(t, recon))?
        let reason: ids.Reason = if recon.actual > recon.committed then "reconciled; actual exceeds committed" else "reconciled"
        store.append_audit(audit.trip_entry(finance_badge, t.id, records.TripStatus.Approved, records.TripStatus.Reconciled, reason))?
        Ok(recon.actual)
      else if t is records.TripReconciled then
        let recon: records.TripReconciliation = compute_reconciliation(store, reg, t, report_id)?
        store.save_trip(records.reconcile_trip_again(t, recon))?
        if recon.actual != t.reconciliation.actual or recon.report != t.reconciliation.report then
          let reason: ids.Reason = if recon.actual > recon.committed then "reconciled again; actual exceeds committed" else "reconciled again"
          store.append_audit(audit.trip_entry(finance_badge, t.id, records.TripStatus.Reconciled, records.TripStatus.Reconciled, reason))?
          Ok(recon.actual)
        else Ok(recon.actual)
      else Err(FailureCode.Conflict, "the trip is not approved or reconciled")
    else Err(FailureCode.Unauthorized, "only active finance staff may reconcile a trip")

  fn close_trip(store, trip_id, finance_badge, reason) =
    let who: staff.Staff = store.staff(finance_badge)?
    if who is staff.Finance then
      let t: records.Trip = store.trip(trip_id)?
      if t is records.TripRequested then
        store.save_trip(records.close_trip_requested(t))?
        store.append_audit(audit.trip_entry(finance_badge, t.id, records.TripStatus.Requested, records.TripStatus.Closed, reason))
      else if t is records.TripApproved then
        store.save_trip(records.close_trip_approved(t))?
        store.append_audit(audit.trip_entry(finance_badge, t.id, records.TripStatus.Approved, records.TripStatus.Closed, reason))
      else Err(FailureCode.Conflict, "the trip is reconciled or already closed")
    else Err(FailureCode.Unauthorized, "only active finance staff may close a trip")
