# desk/trip_desk.brass
module desk.trip_desk
import desk.ids as ids
import desk.staff as staff
import desk.lines as lines
import desk.reports as reports
import desk.records as records
import desk.trips as trips
import desk.audit as audit
import desk.host as host
import desk.registry as registry
import desk.routing as routing
import desk.budget as budget
import desk.delegation as delegation
import std.text as text

interface
  fn file_trip(store: host.Store, badge: ids.Badge, period: ids.Period, region: records.Region, days: trips.Days, vehicle: records.Vehicle, km: trips.Km) -> Outcome<ids.ReportId>
    before days > 0 or km > 0
  fn amend_trip(store: host.Store, trip_id: ids.ReportId, badge: ids.Badge, region: records.Region, days: trips.Days, vehicle: records.Vehicle, km: trips.Km) -> Outcome<trips.TripStatus>
    before days > 0 or km > 0
  fn approve_trip(store: host.Store, reg: registry.Registry, trip_id: ids.ReportId, approver: ids.Badge, today: ids.Period) -> Outcome<trips.TripStatus>
  fn reconcile_trip(store: host.Store, reg: registry.Registry, trip_id: ids.ReportId, report_id: ids.ReportId, finance_badge: ids.Badge) -> Outcome<Int>
  fn close_trip(store: host.Store, trip_id: ids.ReportId, finance_badge: ids.Badge, reason: ids.Reason) -> Outcome<Done>
private
  type Gate = { t: trips.Requested, who: staff.Active, on_behalf_of: Maybe<ids.Badge> }
  fn gate(store: host.Store, reg: registry.Registry, trip_id: ids.ReportId, approver: ids.Badge, today: ids.Period) -> Outcome<Gate>
  fn required_for(store: host.Store, badge: ids.Badge, department: ids.DepartmentId, step: Int) -> Outcome<Maybe<ids.Badge>>
  fn stand_in(store: host.Store, required: ids.Badge) -> Outcome<Maybe<ids.Badge>>
  fn note(base: Text, on_behalf_of: Maybe<ids.Badge>, today: ids.Period) -> ids.Reason
  fn final_step(store: host.Store, t: trips.Requested, who: staff.Active, today: ids.Period, on_behalf_of: Maybe<ids.Badge>) -> Outcome<trips.TripStatus>
  fn close_open(store: host.Store, finance_badge: ids.Badge, t: trips.Trip, reason: ids.Reason) -> Outcome<Done>
body
  fn file_trip(store, badge, period, region, days, vehicle, km) =
    let who: staff.Staff = store.staff(badge)?
    if who is staff.Active then
      let closed: Bool = store.period_closed(period)?
      if not closed then
        let existing: trips.Trips = store.trips_for(who.department, period)?
        if any t in existing where t.badge == badge and t.status in {trips.TripStatus.Requested, trips.TripStatus.Approved, trips.TripStatus.Reconciled} then
          Err(FailureCode.Conflict, "the staff member already has an open trip for this period")
        else
          let committed: Int = trips.price(region, days, vehicle, km)
          let id: ids.ReportId = store.next_id()?
          store.save_trip({ id: id, badge: badge, department: who.department, period: period,
              plan: { region: region, days: days, vehicle: vehicle, km: km }, committed: committed, approvals: [], status: trips.TripStatus.Requested })?
          Ok(id)
      else Err(FailureCode.Conflict, "the period is closed")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn amend_trip(store, trip_id, badge, region, days, vehicle, km) =
    let t: trips.Trip = store.trip(trip_id)?
    if t.badge == badge then
      if t is trips.Open then
        let committed: Int = trips.price(region, days, vehicle, km)
        let updated: trips.Trip = trips.amend(t, { region: region, days: days, vehicle: vehicle, km: km }, committed)
        store.save_trip(updated)?
        if t.status in {trips.TripStatus.Approved} then
          store.append_audit(audit.trip_entry(badge, t.id, t.status, updated.status, "amended; returned to requested"))?
          Ok(updated.status)
        else Ok(updated.status)
      else Err(FailureCode.Conflict, "the trip is reconciled or closed")
    else Err(FailureCode.Unauthorized, "only the staff member who filed this trip may amend it")

  fn approve_trip(store, reg, trip_id, approver, today) =
    let g: Gate = gate(store, reg, trip_id, approver, today)?
    if g.t.approvals.length + 1 >= routing.steps_for(g.t.committed) then final_step(store, g.t, g.who, today, g.on_behalf_of)
    else
      store.save_trip(trips.add_approval(g.t, g.who.badge))?
      store.append_audit(audit.trip_entry(g.who.badge, g.t.id, trips.TripStatus.Requested, trips.TripStatus.Requested, note("approved; awaiting the next approver", g.on_behalf_of, today)))?
      Ok(trips.TripStatus.Requested)

  fn reconcile_trip(store, reg, trip_id, report_id, finance_badge) =
    let who: staff.Staff = store.staff(finance_badge)?
    if who is staff.Finance then
      let t: trips.Trip = store.trip(trip_id)?
      if t is trips.ReconcileReady then
        let r: reports.Report = store.report(report_id)?
        if r.badge == t.badge and r.period == t.period then
          if r.status in {reports.ReportStatus.Approved, reports.ReportStatus.Paid} then
            let txns: records.Txns = reg.txns_for(t.period)?
            let counted: Array<records.TxnId> = []
            let extra: Int = 0
            for tx in txns
              if tx.badge == t.badge and (tx.status in {records.CardStatus.Open, records.CardStatus.Disputed}) then
                counted = counted ++ [tx.id]
                extra = extra + tx.amount
            let actual: Int = lines.total(r.lines) + extra
            let rec: trips.Reconciliation = { committed: t.committed, actual: actual, report: r.id, txns: counted }
            let was: trips.TripStatus = t.status
            let already: Bool = if t.status in {trips.TripStatus.Reconciled} then
                t.reconciliation.committed == rec.committed and t.reconciliation.actual == rec.actual and t.reconciliation.report == rec.report and t.reconciliation.txns.length == rec.txns.length
              else false
            store.save_trip(trips.reconcile(t, rec))?
            if already then Ok(actual)
            else
              let reason: ids.Reason = if actual > t.committed then "reconciled; the actual amount exceeds the committed amount" else "reconciled"
              store.append_audit(audit.trip_entry(finance_badge, t.id, was, trips.TripStatus.Reconciled, reason))?
              Ok(actual)
          else Err(FailureCode.Conflict, "the report is not approved or paid")
        else Err(FailureCode.Conflict, "the report is for another staff member or period")
      else Err(FailureCode.Conflict, "the trip is not approved or reconciled")
    else Err(FailureCode.Unauthorized, "only active finance staff may reconcile a trip")

  fn close_trip(store, trip_id, finance_badge, reason) =
    let who: staff.Staff = store.staff(finance_badge)?
    if who is staff.Finance then
      let t: trips.Trip = store.trip(trip_id)?
      if t is trips.Open then close_open(store, finance_badge, t, reason)
      else Err(FailureCode.Conflict, "the trip is not requested or approved")
    else Err(FailureCode.Unauthorized, "only active finance staff may close a trip")

  fn close_open(store, finance_badge, t, reason) =
    let was: trips.TripStatus = t.status
    store.save_trip(trips.close(t))?
    store.append_audit(audit.trip_entry(finance_badge, t.id, was, trips.TripStatus.Closed, reason))

  fn gate(store, reg, trip_id, approver, today) =
    let who: staff.Staff = store.staff(approver)?
    if who is staff.Active then
      let t: trips.Trip = store.trip(trip_id)?
      if t is trips.Requested then
        let closed: Bool = store.period_closed(t.period)?
        if not closed then
          if who.badge != t.badge then
            let step: Int = t.approvals.length + 1
            let required: Maybe<ids.Badge> = required_for(store, t.badge, t.department, step)?
            if required == None then
              if who.role in {ids.Role.Finance} then Ok({ t: t, who: who, on_behalf_of: None })
              else Err(FailureCode.Unauthorized, "not this trip's next approver")
            else
              if who.badge == required then Ok({ t: t, who: who, on_behalf_of: None })
              else
                let deputy: Maybe<ids.Badge> = delegation.delegate_in_force(reg, required, today)?
                if deputy != None and who.badge == deputy then Ok({ t: t, who: who, on_behalf_of: required })
                else Err(FailureCode.Unauthorized, "not this trip's next approver")
          else Err(FailureCode.Unauthorized, "a trip cannot be approved by its staff member")
        else Err(FailureCode.Conflict, "the period is closed")
      else Err(FailureCode.Conflict, "the trip is not awaiting approval")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn required_for(store, badge, department, step) =
    let role: ids.Role = routing.role_for(step)
    if role in {ids.Role.Finance} then Ok(None)
    else if role in {ids.Role.Supervisor} then
      let person: staff.Staff = store.staff(badge)?
      if person.supervisor != None then stand_in(store, person.supervisor)
      else Err(FailureCode.Conflict, "the staff member has no supervisor")
    else
      let dept: staff.Department = store.department(department)?
      stand_in(store, dept.director)

  fn stand_in(store, required) =
    let person: staff.Staff = store.staff(required)?
    if person.active then Ok(required)
    else if person.supervisor != None then
      let up: staff.Staff = store.staff(person.supervisor)?
      if up.active then Ok(person.supervisor)
      else Err(FailureCode.Conflict, "no active approver stands in for " ++ required)
    else Err(FailureCode.Conflict, "no active approver stands in for " ++ required)

  fn note(base, on_behalf_of, today) =
    if on_behalf_of != None then base ++ " on behalf of " ++ on_behalf_of ++ ", period " ++ text.of(today)
    else base

  fn final_step(store, t, who, today, on_behalf_of) =
    let dept: staff.Department = store.department(t.department)?
    let rs: reports.Reports = store.reports_for(t.department, t.period)?
    let spent: Int = budget.department_spend(store, t.department, t.period)?
    let contribution: Int = budget.trip_remaining(t.committed, budget.badge_reports_budgeted(rs, t.badge))
    let within: Bool = spent + contribution <= dept.budget
    if within or who.role in {ids.Role.Finance} then
      let reason: ids.Reason = note(if within then "approved" else "approved; budget override", on_behalf_of, today)
      store.save_trip(trips.approve(t))?
      store.append_audit(audit.trip_entry(who.badge, t.id, trips.TripStatus.Requested, trips.TripStatus.Approved, reason))?
      Ok(trips.TripStatus.Approved)
    else Err(FailureCode.Conflict, "the department budget for this period would be exceeded")
