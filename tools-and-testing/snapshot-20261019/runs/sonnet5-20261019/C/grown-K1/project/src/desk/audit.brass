# desk/audit.brass
module desk.audit
import desk.ids as ids
import desk.status as status

interface
  type Entry = { who: ids.Badge, report: ids.ReportId, was: status.Step, now: status.Step, reason: ids.Reason }

  fn entry(who: ids.Badge, report: ids.ReportId, was: status.Step, now: status.Step, reason: ids.Reason) -> Entry
    after result.who == who and result.report == report
body
  fn entry(who, report, was, now, reason) = { who: who, report: report, was: was, now: now, reason: reason }
