# desk/advances.brass
module desk.advances
import desk.ids as ids
import desk.lines as lines
import desk.staff as staff
import desk.reports as reports
import desk.audit as audit
import desk.host as host
import desk.routing as routing
import desk.budget as budget
import desk.review as review

interface
  type Ids    = Array<ids.ReportId> where it.length in 0 to 1000
  type Amount = ids.Money where it in 1 to 1000000000

  fn request_advance(store: host.Store, badge: ids.Badge, period: ids.Period, amount: Amount) -> Outcome<ids.ReportId>
  fn approve_advance(store: host.Store, advance_id: ids.ReportId, approver: ids.Badge) -> Outcome<reports.AdvanceStatus>
  fn pay_advance(store: host.Store, ledger: host.Ledger, advance_id: ids.ReportId, finance_badge: ids.Badge) -> Outcome<Text>
  fn pay_against(store: host.Store, ledger: host.Ledger, report_id: ids.ReportId, advance_id: ids.ReportId, finance_badge: ids.Badge) -> Outcome<Text>
  fn outstanding_advances(store: host.Store, today: ids.Period) -> Outcome<Ids>
private
  type Gate = { a: reports.AdvanceRequested, who: staff.Active }

  fn gate_advance(store: host.Store, advance_id: ids.ReportId, approver: ids.Badge) -> Outcome<Gate>
  fn final_approval(store: host.Store, a: reports.AdvanceRequested, who: staff.Active) -> Outcome<reports.AdvanceStatus>
body
  fn request_advance(store, badge, period, amount) =
    let who: staff.Staff = store.staff(badge)?
    if who is staff.Active then
      let closed: Bool = store.period_closed(period)?
      if not closed then
        let id: ids.ReportId = store.next_id()?
        store.save_advance({ id: id, badge: badge, department: who.department, period: period, amount: amount, status: reports.AdvanceStatus.Requested, approvals: [] })?
        Ok(id)
      else Err(FailureCode.Conflict, "the period is closed")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn approve_advance(store, advance_id, approver) =
    let g: Gate = gate_advance(store, advance_id, approver)?
    if g.a.approvals.length + 1 >= routing.steps_for(g.a.amount) then final_approval(store, g.a, g.who)
    else
      store.save_advance(reports.add_advance_approval(g.a, g.who.badge))?
      store.append_audit(audit.entry(g.who.badge, g.a.id, reports.state_of_advance(reports.AdvanceStatus.Requested), reports.state_of_advance(reports.AdvanceStatus.Requested), "approved; awaiting the next approver"))?
      Ok(reports.AdvanceStatus.Requested)

  fn pay_advance(store, ledger, advance_id, finance_badge) =
    let who: staff.Staff = store.staff(finance_badge)?
    if who is staff.Finance then
      let a: reports.Advance = store.advance(advance_id)?
      if a is reports.AdvanceApproved then
        let reference: Text = ledger.pay(a.badge, a.amount, a.id)?
        store.save_advance(reports.pay_advance(a, reference))?
        store.append_audit(audit.entry(who.badge, a.id, reports.state_of_advance(reports.AdvanceStatus.Approved), reports.state_of_advance(reports.AdvanceStatus.Paid), "paid"))?
        Ok(reference)
      else Err(FailureCode.Conflict, "the advance is not approved")
    else Err(FailureCode.Unauthorized, "only active finance staff may pay")

  fn pay_against(store, ledger, report_id, advance_id, finance_badge) =
    let who: staff.Staff = store.staff(finance_badge)?
    if who is staff.Finance then
      let r: reports.Report = store.report(report_id)?
      let a: reports.Advance = store.advance(advance_id)?
      if r is reports.Approved and a is reports.AdvancePaid then
        if a.badge == r.badge and a.period == r.period then
          let total: Int = lines.total(r.lines)
          if a.amount >= total then
            let owed: ids.Money = a.amount - total
            store.save_report(reports.pay(r, a.reference))?
            store.save_advance(reports.settle_advance(a, owed))?
            store.append_audit(audit.entry(who.badge, r.id, reports.state_of_report(reports.ReportStatus.Approved), reports.state_of_report(reports.ReportStatus.Paid), "paid; settled against advance " ++ a.id))?
            store.append_audit(audit.entry(who.badge, a.id, reports.state_of_advance(reports.AdvanceStatus.Paid), reports.state_of_advance(reports.AdvanceStatus.Settled), "settled against report " ++ r.id))?
            Ok("settled")
          else
            let reference: Text = ledger.pay(r.badge, total - a.amount, r.id)?
            store.save_report(reports.pay(r, reference))?
            store.save_advance(reports.settle_advance(a, 0))?
            store.append_audit(audit.entry(who.badge, r.id, reports.state_of_report(reports.ReportStatus.Approved), reports.state_of_report(reports.ReportStatus.Paid), "paid; settled against advance " ++ a.id))?
            store.append_audit(audit.entry(who.badge, a.id, reports.state_of_advance(reports.AdvanceStatus.Paid), reports.state_of_advance(reports.AdvanceStatus.Settled), "settled against report " ++ r.id))?
            Ok(reference)
        else Err(FailureCode.Conflict, "the advance does not belong to this report's staff member and period")
      else Err(FailureCode.Conflict, "the report is not approved or the advance is not paid")
    else Err(FailureCode.Unauthorized, "only active finance staff may pay")

  fn outstanding_advances(store, today) =
    let paid: reports.Advances = store.paid_advances()?
    let out: Ids = []
    for a in paid
      if a.period + 2 < today then out = out ++ [a.id]
    Ok(out)

  fn gate_advance(store, advance_id, approver) =
    let who: staff.Staff = store.staff(approver)?
    if who is staff.Active then
      let a: reports.Advance = store.advance(advance_id)?
      if a is reports.AdvanceRequested then
        let closed: Bool = store.period_closed(a.period)?
        if not closed then
          if who.badge != a.badge then
            let allowed: Bool = review.may_act_on(store, a.department, a.badge, a.approvals.length, who)?
            if allowed then Ok({ a: a, who: who })
            else Err(FailureCode.Unauthorized, "not this advance's next approver")
          else Err(FailureCode.Unauthorized, "an advance cannot be approved by its requester")
        else Err(FailureCode.Conflict, "the period is closed")
      else Err(FailureCode.Conflict, "the advance is not awaiting approval")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn final_approval(store, a, who) =
    let dept: staff.Department = store.department(a.department)?
    let other_reports: reports.Reports = store.reports_for(a.department, a.period)?
    let other_advances: reports.Advances = store.advances_for(a.department, a.period)?
    let within: Bool = budget.spend_of(other_reports) + budget.advance_spend_of(other_advances) + a.amount <= dept.budget
    if within or who.role in {ids.Role.Finance} then
      let reason: ids.Reason = if within then "approved" else "approved; budget override"
      store.save_advance(reports.approve_advance(a))?
      store.append_audit(audit.entry(who.badge, a.id, reports.state_of_advance(reports.AdvanceStatus.Requested), reports.state_of_advance(reports.AdvanceStatus.Approved), reason))?
      Ok(reports.AdvanceStatus.Approved)
    else Err(FailureCode.Conflict, "the department budget for this period would be exceeded")
