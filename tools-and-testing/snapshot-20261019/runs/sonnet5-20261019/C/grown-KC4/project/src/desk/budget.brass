# desk/budget.brass
module desk.budget
import desk.lines as lines
import desk.reports as reports

interface
  fn spend_of(rs: reports.Reports) -> Int
    after result >= 0
body
  fn spend_of(rs) =
    let sum: Int = 0
    for r in rs
      if r is reports.Counted then sum = sum + lines.budgeted_total(r.lines)
    sum
