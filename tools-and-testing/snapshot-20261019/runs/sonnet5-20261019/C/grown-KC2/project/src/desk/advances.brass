# desk/advances.brass
module desk.advances
import desk.ids as ids
import desk.lines as lines
import desk.staff as staff
import desk.reports as reports
import desk.audit as audit
import desk.host as host
import desk.routing as routing
import desk.budget as budget

interface
  type Ids = Array<ids.ReportId> where it.length in 0 to 1000

  fn request_advance(store: host.Store, badge: ids.Badge, period: ids.Period, amount: ids.Money) -> Outcome<ids.ReportId>
  fn approve_advance(store: host.Store, advance_id: ids.ReportId, approver: ids.Badge) -> Outcome<reports.AdvanceStatus>
  fn pay_advance(store: host.Store, ledger: host.Ledger, advance_id: ids.ReportId, finance_badge: ids.Badge) -> Outcome<Text>
  fn pay_against(store: host.Store, ledger: host.Ledger, report_id: ids.ReportId, advance_id: ids.ReportId, finance_badge: ids.Badge) -> Outcome<Text>
  fn outstanding_advances(store: host.Store, today: ids.Period) -> Outcome<Ids>
private
  type Gate = { a: reports.RequestedAdvance, who: staff.Active }

  fn gate(store: host.Store, advance_id: ids.ReportId, approver: ids.Badge) -> Outcome<Gate>
  fn allowed_approver(store: host.Store, a: reports.RequestedAdvance, who: staff.Active) -> Outcome<Bool>
  fn required_for(store: host.Store, a: reports.RequestedAdvance) -> Outcome<Maybe<ids.Badge>>
  fn stand_in(store: host.Store, required: ids.Badge) -> Outcome<Maybe<ids.Badge>>
  fn final_approval(store: host.Store, a: reports.RequestedAdvance, who: staff.Active) -> Outcome<reports.AdvanceStatus>
body
  fn request_advance(store, badge, period, amount) =
    let who: staff.Staff = store.staff(badge)?
    if who is staff.Active then
      if amount >= 1 then
        let closed: Bool = store.period_closed(period)?
        if not closed then
          let id: ids.ReportId = store.next_id()?
          store.save_advance({ id: id, badge: badge, department: who.department, period: period, amount: amount, status: reports.AdvanceStatus.Requested, approvals: [] })?
          Ok(id)
        else Err(FailureCode.Conflict, "the period is closed")
      else Err(FailureCode.InvalidInput, "an advance is for at least 1 cent")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn approve_advance(store, advance_id, approver) =
    let g: Gate = gate(store, advance_id, approver)?
    if g.a.approvals.length + 1 >= routing.steps_for(g.a.amount) then final_approval(store, g.a, g.who)
    else
      store.save_advance(reports.add_advance_approval(g.a, g.who.badge))?
      store.append_audit(audit.entry(g.who.badge, g.a.id, reports.of_advance(reports.AdvanceStatus.Requested), reports.of_advance(reports.AdvanceStatus.Requested), "approved; awaiting the next approver"))?
      Ok(reports.AdvanceStatus.Requested)

  fn pay_advance(store, ledger, advance_id, finance_badge) =
    let who: staff.Staff = store.staff(finance_badge)?
    if who is staff.Finance then
      let a: reports.Advance = store.advance(advance_id)?
      if a is reports.ApprovedAdvance then
        let reference: Text = ledger.pay(a.badge, a.amount, a.id)?
        store.save_advance(reports.advance_pay(a, reference))?
        store.append_audit(audit.entry(who.badge, a.id, reports.of_advance(reports.AdvanceStatus.Approved), reports.of_advance(reports.AdvanceStatus.Paid), "paid"))?
        Ok(reference)
      else Err(FailureCode.Conflict, "the advance is not approved")
    else Err(FailureCode.Unauthorized, "only active finance staff may pay")

  fn pay_against(store, ledger, report_id, advance_id, finance_badge) =
    let who: staff.Staff = store.staff(finance_badge)?
    if who is staff.Finance then
      let r: reports.Report = store.report(report_id)?
      if r is reports.Approved then
        let a: reports.Advance = store.advance(advance_id)?
        if a is reports.PaidAdvance then
          if a.badge == r.badge and a.period == r.period then
            let due: Int = lines.total(r.lines)
            if a.amount >= due then
              let owed: ids.Money = a.amount - due
              store.save_advance(reports.advance_settle(a, owed))?
              store.save_report(reports.pay(r, a.reference))?
              store.append_audit(audit.entry(who.badge, a.id, reports.of_advance(reports.AdvanceStatus.Paid), reports.of_advance(reports.AdvanceStatus.Settled), "settled against " ++ r.id))?
              store.append_audit(audit.entry(who.badge, r.id, reports.of_report(reports.ReportStatus.Approved), reports.of_report(reports.ReportStatus.Paid), "paid by advance"))?
              Ok("settled")
            else
              let reference: Text = ledger.pay(r.badge, due - a.amount, r.id)?
              store.save_advance(reports.advance_settle(a, 0))?
              store.save_report(reports.pay(r, reference))?
              store.append_audit(audit.entry(who.badge, a.id, reports.of_advance(reports.AdvanceStatus.Paid), reports.of_advance(reports.AdvanceStatus.Settled), "settled against " ++ r.id))?
              store.append_audit(audit.entry(who.badge, r.id, reports.of_report(reports.ReportStatus.Approved), reports.of_report(reports.ReportStatus.Paid), "paid"))?
              Ok(reference)
          else Err(FailureCode.Conflict, "the advance is not for this staff member and period")
        else Err(FailureCode.Conflict, "the advance has not been paid")
      else Err(FailureCode.Conflict, "the report is not approved")
    else Err(FailureCode.Unauthorized, "only active finance staff may pay")

  fn outstanding_advances(store, today) =
    let paid: reports.Advances = store.paid_advances()?
    let out: Ids = []
    for a in paid
      if a.period + 2 < today then out = out ++ [a.id]
    Ok(out)

  fn gate(store, advance_id, approver) =
    let who: staff.Staff = store.staff(approver)?
    if who is staff.Active then
      let a: reports.Advance = store.advance(advance_id)?
      if a is reports.RequestedAdvance then
        let closed: Bool = store.period_closed(a.period)?
        if not closed then
          if who.badge != a.badge then
            let allowed: Bool = allowed_approver(store, a, who)?
            if allowed then Ok({ a: a, who: who })
            else Err(FailureCode.Unauthorized, "not this advance's next approver")
          else Err(FailureCode.Unauthorized, "an advance cannot be approved by its requester")
        else Err(FailureCode.Conflict, "the period is closed")
      else Err(FailureCode.Conflict, "the advance is not awaiting approval")
    else Err(FailureCode.Unauthorized, "staff member is not active")

  fn allowed_approver(store, a, who) =
    let required: Maybe<ids.Badge> = required_for(store, a)?
    if required == None then Ok(who.role in {ids.Role.Finance})
    else Ok(who.badge == required)

  fn required_for(store, a) =
    let role: ids.Role = routing.role_for(a.approvals.length + 1)
    if role in {ids.Role.Finance} then Ok(None)
    else if role in {ids.Role.Supervisor} then
      let requester: staff.Staff = store.staff(a.badge)?
      if requester.supervisor != None then stand_in(store, requester.supervisor)
      else Err(FailureCode.Conflict, "the requester has no supervisor")
    else
      let dept: staff.Department = store.department(a.department)?
      stand_in(store, dept.director)

  fn stand_in(store, required) =
    let person: staff.Staff = store.staff(required)?
    if person.active then Ok(required)
    else if person.supervisor != None then
      let up: staff.Staff = store.staff(person.supervisor)?
      if up.active then Ok(person.supervisor)
      else Err(FailureCode.Conflict, "no active approver stands in for " ++ required)
    else Err(FailureCode.Conflict, "no active approver stands in for " ++ required)

  fn final_approval(store, a, who) =
    let dept: staff.Department = store.department(a.department)?
    let others: reports.Reports = store.reports_for(a.department, a.period)?
    let other_advances: reports.Advances = store.advances_for(a.department, a.period)?
    let within: Bool = budget.spend_of(others) + budget.advance_spend_of(other_advances) + a.amount <= dept.budget
    if within or who.role in {ids.Role.Finance} then
      let reason: ids.Reason = if within then "approved" else "approved; budget override"
      store.save_advance(reports.advance_approve(a))?
      store.append_audit(audit.entry(who.badge, a.id, reports.of_advance(reports.AdvanceStatus.Requested), reports.of_advance(reports.AdvanceStatus.Approved), reason))?
      Ok(reports.AdvanceStatus.Approved)
    else Err(FailureCode.Conflict, "the department budget for this period would be exceeded")
