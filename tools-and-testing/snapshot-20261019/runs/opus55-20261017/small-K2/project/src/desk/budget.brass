# desk/budget.brass
module desk.budget
import desk.lines as lines
import desk.reports as reports
import desk.advances as advances

interface
  fn spend_of(rs: reports.Reports) -> Int
    after result >= 0
  fn advance_spend_of(xs: advances.Advances) -> Int
    after result >= 0
  fn total_spend(rs: reports.Reports, xs: advances.Advances) -> Int
    after result >= 0
body
  fn spend_of(rs) =
    let sum: Int = 0
    for r in rs
      if r is reports.Counted then sum = sum + lines.budgeted_total(r.lines)
    sum

  fn advance_spend_of(xs) =
    let sum: Int = 0
    for a in xs
      if a is advances.Counted then sum = sum + a.amount
    sum

  fn total_spend(rs, xs) = spend_of(rs) + advance_spend_of(xs)
