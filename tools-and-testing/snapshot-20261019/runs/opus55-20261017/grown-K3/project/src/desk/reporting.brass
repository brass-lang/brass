# desk/reporting.brass
module desk.reporting
import desk.ids as ids
import desk.staff as staff
import desk.reports as reports
import desk.records as records
import desk.host as host
import desk.registry as registry

interface
  type PeriodSummary = { department: ids.DepartmentId, period: ids.Period, submitted: Int, approved: Int, paid: Int, open_card_txns: Int, po_committed: Int }

  fn period_summary(store: host.Store, reg: registry.Registry, department: ids.DepartmentId, period: ids.Period) -> Outcome<PeriodSummary>
body
  fn period_summary(store, reg, department, period) =
    let dept: staff.Department = store.department(department)?
    let rs: reports.Reports = store.reports_for(dept.id, period)?
    let submitted: Int = 0
    let approved: Int = 0
    let paid: Int = 0
    for r in rs
      if r.status in {reports.ReportStatus.Submitted} then submitted = submitted + 1
      else if r.status in {reports.ReportStatus.Approved} then approved = approved + 1
      else if r.status in {reports.ReportStatus.Paid} then paid = paid + 1
    let ts: records.Txns = reg.txns_for(period)?
    let open: Int = 0
    for t in ts
      if t.status in {records.CardStatus.Open} then
        let holder: Outcome<staff.Staff> = store.staff(t.badge)
        if holder is Ok then
          let h: staff.Staff = holder?
          if h.department == dept.id then open = open + 1
    let pos: records.POs = reg.pos_for(dept.id, period)?
    Ok({ department: dept.id, period: period, submitted: submitted, approved: approved, paid: paid, open_card_txns: open, po_committed: records.commitments(pos) })
