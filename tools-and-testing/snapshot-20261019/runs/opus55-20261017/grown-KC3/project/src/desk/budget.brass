# desk/budget.brass
module desk.budget
import desk.lines as lines
import desk.reports as reports
import desk.advance_records as advs

interface
  fn spend_of(rs: reports.Reports) -> Int
    after result >= 0
  fn advance_spend(xs: advs.Advances) -> Int
    after result >= 0
body
  fn advance_spend(xs) =
    let sum: Int = 0
    for a in xs
      if a is advs.Counted then sum = sum + a.amount
    sum

  fn spend_of(rs) =
    let sum: Int = 0
    for r in rs
      if r is reports.Counted then sum = sum + lines.budgeted_total(r.lines)
    sum
