# desk/audit.brass
module desk.audit
import desk.ids as ids
import desk.reports as reports
import desk.records as records

interface
  type State = Draft | Submitted | Approved | Rejected | ChangesRequested | Paid | Requested | Settled
  type Entry = { who: ids.Badge, report: ids.ReportId, was: State, now: State, reason: ids.Reason }

  fn entry(who: ids.Badge, report: ids.ReportId, was: reports.ReportStatus, now: reports.ReportStatus, reason: ids.Reason) -> Entry
    after result.who == who and result.report == report
  fn advance_entry(who: ids.Badge, advance: records.AdvanceId, was: records.AdvanceStatus, now: records.AdvanceStatus, reason: ids.Reason) -> Entry
    after result.who == who and result.report == advance

  fn of_report(s: reports.ReportStatus) -> State
    example of_report(reports.ReportStatus.ChangesRequested) == State.ChangesRequested
  fn of_advance(s: records.AdvanceStatus) -> State
    example of_advance(records.AdvanceStatus.Settled) == State.Settled
body
  fn entry(who, report, was, now, reason) = { who: who, report: report, was: of_report(was), now: of_report(now), reason: reason }

  fn advance_entry(who, advance, was, now, reason) = { who: who, report: advance, was: of_advance(was), now: of_advance(now), reason: reason }

  fn of_report(s) =
    if s in {reports.ReportStatus.Draft} then State.Draft
    else if s in {reports.ReportStatus.Submitted} then State.Submitted
    else if s in {reports.ReportStatus.Approved} then State.Approved
    else if s in {reports.ReportStatus.Rejected} then State.Rejected
    else if s in {reports.ReportStatus.ChangesRequested} then State.ChangesRequested
    else State.Paid

  fn of_advance(s) =
    if s in {records.AdvanceStatus.Requested} then State.Requested
    else if s in {records.AdvanceStatus.Approved} then State.Approved
    else if s in {records.AdvanceStatus.Paid} then State.Paid
    else State.Settled
